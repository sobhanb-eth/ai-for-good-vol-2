# FakeSpotter Arena settings
# 1. Copy this file and name the copy ".env" (in the same folder as server.js).
# 2. Paste your keys after the = signs. Leave a line empty to switch that feature off.
# 3. Restart the server (stop it with Ctrl+C, then run: node server.js).
# Never share your .env file or commit it to GitHub.

# Port the app runs on (http://localhost:3000)
PORT=3000

# --- The AI for analysis + coach: set ONE of these two ---
# It writes the draft analysis on "Add a post" and grades students' reasoning.
# It is NOT an AI detector: it describes what looks suspicious, it can't give a reliable "% AI" score.

# Option A: GPT (OpenAI). Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any OpenAI model that accepts images. Change it if your account lists a newer one.
OPENAI_MODEL=gpt-4.1-mini

# Option B: Claude (Anthropic). Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# If you set both keys, choose one: openai or anthropic
LLM_PROVIDER=

# --- Hive: AI-generated IMAGE and AUDIO detection ---
# Self-serve key: sign in at https://thehive.ai -> left sidebar "Service API Keys" -> "Create API Key".
# (Direct link: https://thehive.ai/explore?api_keys=1). Free tier: about 100 requests per day.
# Docs: https://docs.thehive.ai/docs/ai-generated-and-deepfake-content-detection-playground
HIVE_API_KEY=
# v3 for the self-serve key above (default). Use v2 only if Hive sales gave you an enterprise project key.
HIVE_API_VERSION=v3
# Leave empty to use the default endpoint for the version above.
HIVE_API_URL=

# Optional: a separate key/endpoint for audio. Leave empty to use HIVE_API_KEY for audio too.
HIVE_AUDIO_API_KEY=
HIVE_AUDIO_API_URL=

# --- GPTZero: AI-written TEXT detection ---
# Get a key: https://gptzero.me  (API section of your account)
GPTZERO_API_KEY=
GPTZERO_API_URL=https://api.gptzero.me/v2/predict/text
