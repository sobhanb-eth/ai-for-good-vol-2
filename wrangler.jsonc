// Cloudflare Workers config for the OpenNext build (https://opennext.js.org/cloudflare).
// API keys are NOT here: set them as Worker secrets (npx wrangler secret put OPENAI_API_KEY, ...).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fakespotter-arena",
  // Generated by `opennextjs-cloudflare build`; OpenNext requires these two values unchanged.
  "main": ".open-next/worker.js",
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "compatibility_date": "2026-11-01",
  // nodejs_compat: Buffer, process.env and other Node APIs used by the route handlers.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Lets OpenNext call back into this Worker (cache revalidation); must match "name".
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "fakespotter-arena" }],
  "observability": { "enabled": true }
}
