# FakeSpotter Arena settings
# 1. Copy this file and name the copy ".env.local" (in the repo root).
# 2. Paste your keys after the = signs. Leave a line empty to switch that feature off.
# 3. Restart the app (stop it with Ctrl+C, then run: npm run dev).
# Never share your .env.local file or commit it to GitHub.

# --- LLM (OpenAI-compatible) ---
# Drafts the analysis on "Add a post" and coaches students' reasoning.
# Any OpenAI-compatible provider works: point OPENAI_BASE_URL at it.
# OpenAI: https://api.openai.com/v1  (key: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Hive: AI-generated IMAGE detection ---
# Create an "AI-Generated Content Detection" project in your Hive dashboard and copy its API key.
# Docs: https://docs.thehive.ai/docs/ai-image-and-video-detection
HIVE_API_KEY=
# Change only if your Hive dashboard shows a different endpoint for the project.
HIVE_API_URL=https://api.thehive.ai/api/v2/task/sync

# --- Hive: AI-generated AUDIO detection (optional) ---
# Hive gives a separate key per project. Leave empty to reuse HIVE_API_KEY.
# Docs: https://docs.thehive.ai/docs/ai-generated-audio-detection
HIVE_AUDIO_API_KEY=
HIVE_AUDIO_API_URL=https://api.thehive.ai/api/v2/task/sync

# --- OpenAI: AI-written TEXT detection ---
# Uses OPENAI_API_KEY / OPENAI_BASE_URL above. Picks the model that judges AI text.
# Options on a current OpenAI account: gpt-6.1-terra (default), gpt-6-luna, gpt-6.1-sol.
OPENAI_TEXT_MODEL=gpt-6.1-terra
