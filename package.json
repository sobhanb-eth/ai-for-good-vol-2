{
  "name": "fakespotter-arena",
  "version": "2.0.0",
  "description": "A real-or-fake game that trains students to spot AI fakes, with a teacher dashboard and live AI detectors. Next.js PWA.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "bash scripts/deploy-cloudflare.sh",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "UNLICENSED"
}
